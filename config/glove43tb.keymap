#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <layout_shift_kp_override.dtsi>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&kp Q         &kp W  &kp E  &kp R      &kp T                                                             &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A         &kp S  &kp D  &kp F      &kp G            &none                     &kp INT5               &kp H        &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z         &kp X  &kp C  &kp V      &kp B            &kp LCTRL                 &kp INT4               &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_WIN  &none  &none  &lt 1 TAB  &lt 2 BACKSPACE  &mt LEFT_SHIFT SPACE      &mt RIGHT_SHIFT SPACE  &lt 3 ENTER                             &kp PRINTSCREEN
            >;

            sensor-bindings = <&mouse_wheel_scroll SCRL_DOWN SCRL_UP>;
        };

        NUM_BRACKET {
            bindings = <
&kp N9        &kp N8        &kp N7        &kp NUMBER_6  &kp N5                          &kp SQT            &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none  &none
&kp NUMBER_4  &kp NUMBER_3  &kp NUMBER_2  &kp NUMBER_1  &kp NUMBER_0  &none      &none  &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none  &none
&none         &none         &none         &none         &none         &none      &none  &kp COLON          &kp LEFT_BRACE        &kp RIGHT_BRACE        &none  &none
&none         &none         &none         &none         &none         &none      &none  &none                                                                  &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_DEC C_BRIGHTNESS_INC>;
        };

        SYMBOL_NUM {
            bindings = <
&kp LCTRL     &kp PERCENT  &kp AMPERSAND  &kp PIPE   &kp EXCLAMATION                         &kp NUMBER_5    &kp NUMBER_6   &kp NUMBER_7      &kp NUMBER_8  &kp NUMBER_9
&kp ASTERISK  &kp SLASH    &kp PLUS       &kp MINUS  &kp EQUAL        &none           &none  &kp NUMBER_0    &kp NUMBER_1   &kp NUMBER_2      &kp NUMBER_3  &kp NUMBER_4
&kp AT_SIGN   &kp DOLLAR   &kp HASH       &kp TILDE  &none            &kp ESCAPE      &none  &kp UNDERSCORE  &kp LESS_THAN  &kp GREATER_THAN  &none         &none
&none         &none        &none          &none      &none            &none           &none  &none                                                          &none
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        ARROW {
            bindings = <
&none         &none      &none      &kp F12    &kp F5                                          &kp HOME      &kp PAGE_DOWN  &kp PAGE_UP       &kp END        &none
&kp LC(A)     &kp LC(S)  &none      &kp LC(F)  &kp F2  &none                &kp RC(PAGE_UP)    &kp LEFT      &kp DOWN       &kp UP_ARROW      &kp RIGHT      &none
&kp LC(Z)     &kp LC(X)  &kp LC(C)  &kp LC(V)  &none   &kp LS(LA(TAB))      &kp RC(PAGE_DOWN)  &kp RC(LEFT)  &kp RC(DOWN)   &kp RC(UP_ARROW)  &kp RC(RIGHT)  &none
&kp LEFT_WIN  &none      &none      &none      &none   &kp LEFT_SHIFT       &none              &none                                                         &bt BT_CLR
            >;
        };

        MOUSE {
            bindings = <
&none  &none  &none  &none   &none                       &none          &none     &kp LC(W)   &none     &none
&none  &none  &none  &none   &none   &none       &none   &kp PAGE_UP    &mkp MB1  &mkp MB3    &mkp MB2  &none
&none  &none  &none  &none   &none   &none       &none   &kp PAGE_DOWN  &none     &kp RA(F4)  &none     &none
&none  &none  &none  &trans  &trans  &trans      &trans  &trans                                         &none
            >;
        };
    };
};
